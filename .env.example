# WordChain Environment Configuration

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL - Neon, Supabase, or Render)
# If empty, the server automatically starts embedded in-memory PostgreSQL (PGlite) for zero-setup local dev!
DATABASE_URL=

# Authentication Secrets
JWT_SECRET=super_secret_wordchain_jwt_signing_key_change_in_production_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_wordchain_cookie_secret_2026

# Email / SMTP (Optional for local dev - logs tokens to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WordChain Security <noreply@wordchain.gg>"
