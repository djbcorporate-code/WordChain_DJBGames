# ==============================================================================
# WordChain Environment Configuration Template
# ==============================================================================

# Server Network & Runtime
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:4000
SERVE_STATIC=true

# Database (PostgreSQL - Local, Neon, Supabase, Render, or Docker Compose)
# Option 1 (Zero-Setup): Leave DATABASE_URL empty. The server automatically initializes embedded persistent PostgreSQL (PGlite) stored locally in .data/pglite!
# Option 2 (External / Cloud Postgres): Provide a connection string, e.g.:
# DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
# For Docker Compose: postgres://wordchain_user:wordchain_secure_password_2026@postgres:5432/wordchain
DATABASE_URL=

# Authentication Secrets (Must be changed to cryptographically secure strings in production)
JWT_SECRET=super_secret_wordchain_jwt_signing_key_change_in_production_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_wordchain_cookie_secret_2026

# Optional: Email / SMTP (Logs verification tokens & reset links to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WordChain Academic League <noreply@wordchain.gg>"
